# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_GENERATION_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Database
DATABASE_PATH=./data/skilldrill.db

# Generation
GENERATION_BATCH_SIZE=75
GENERATION_LOW_WATERMARK=15
GENERATION_MAX_RETRIES=3
DEDUP_SIMILARITY_THRESHOLD=0.9

# Auth (single app-level PIN gate, not per-profile)
APP_PIN=changeme
SESSION_SECRET=changeme-please-randomize-this-in-your-own-.env

# Grading
SCENARIO_PASS_THRESHOLD=70

# API / frontend
CORS_ORIGIN=http://localhost:5173
